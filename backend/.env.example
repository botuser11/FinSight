# Set to "production" outside Render (Render is detected automatically via RENDER=true)
ENVIRONMENT=development
DATABASE_URL=sqlite:///./finsight.db
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
TRUELAYER_CLIENT_ID=your-truelayer-client-id
TRUELAYER_CLIENT_SECRET=your-truelayer-client-secret
TRUELAYER_REDIRECT_URI=http://localhost:8000/banking/callback
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com
TRUELAYER_API_URL=https://api.truelayer-sandbox.com
# "mock" for the sandbox mock bank; e.g. "uk-ob-all uk-oauth-all" for real banks
TRUELAYER_PROVIDERS=mock
# Encrypts bank tokens at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
# Required in production (CORS + post-bank-connect redirect)
FRONTEND_URL=http://localhost:5173
